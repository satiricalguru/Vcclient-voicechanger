{
  "name": "vcclient-voicechanger",
  "version": "2.0.78-beta",
  "description": "Modern Electron shell for w-okada's Voice Changer — upgraded UI with glassmorphism themes, real-time status, and particle effects.",
  "main": "main.js",
  "author": "satiricalguru",
  "license": "MIT",
  "homepage": "https://github.com/satiricalguru/Vcclient-voicechanger",
  "repository": {
    "type": "git",
    "url": "https://github.com/satiricalguru/Vcclient-voicechanger.git"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "lint": "eslint main.js",
    "create-ico": "python scripts/create_ico.py",
    "dist": "electron-builder"
  },
  "devDependencies": {
    "electron": "^42.4.0",
    "electron-builder": "^24.13.3",
    "eslint": "^9.0.0"
  },
  "build": {
    "appId": "com.voice.changer.client",
    "productName": "Vcclient",
    "directories": {
      "output": "dist-built"
    },
    "files": [
      "**/*",
      "!dist/modules/**/*",
      "!dist/model_dir/**/*",
      "!dist/static_model_dir/**/*",
      "!dist/upload_dir/**/*",
      "!dist/tmp_dir/**/*",
      "!dist/settings/**/*",
      "!dist/*.log",
      "!dist/*.txt",
      "!modules/**/*",
      "!model_dir/**/*",
      "!static_model_dir/**/*",
      "!upload_dir/**/*",
      "!tmp_dir/**/*",
      "!settings/**/*",
      "!*.log",
      "!*.txt"
    ],
    "asar": true,
    "asarUnpack": [
      "dist/**"
    ],
    "win": {
      "icon": "app-icon.ico",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Vcclient"
    }
  },
  "keywords": [
    "voice-changer",
    "ai",
    "rvc",
    "beatrice",
    "electron",
    "real-time",
    "voice-conversion"
  ]
}
